# Configurações do Perfil AWS e Região Padrão
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-1

# Diretórios locais de saída
REPORTS_DIR=./reports
LOGS_DIR=./logs

# CloudQuery - API Key (obrigatória para v6+)
# Crie uma conta gratuita em https://cloud.cloudquery.io
# Gere uma API key em Settings > API Keys
# O free tier é suficiente para uso de laboratório
CLOUDQUERY_API_KEY=

# Configurações do AWS Billing Data Exports
AWS_BILLING_S3_BUCKET=my-aws-billing-exports-bucket
AWS_BILLING_EXPORT_NAME=standard-cur-export
